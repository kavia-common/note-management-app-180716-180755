---
import ThemeToggle from '../components/ThemeToggle.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Ocean Notes</title>
  </head>
  <body>
    <ThemeToggle />
    <slot />
  </body>
</html>

<style>
  :root {
    /* Ocean Professional theme - light */
    --bg-color: #f9fafb;
    --background: #f9fafb;
    --surface: #ffffff;
    --text-color: #111827;
    --text-secondary: #4b5563;
    --primary: #2563EB;
    --secondary: #F59E0B;
    --error: #EF4444;
    --border-color: rgba(0, 0, 0, 0.1);
    --card-bg: rgba(255, 255, 255, 1);
    --card-hover-bg: rgba(255, 255, 255, 0.55);
    --shadow-color: rgba(0, 0, 0, 0.08);
    --shadow-hover-color: rgba(0, 0, 0, 0.15);
  }

  body.dark-theme {
    /* Ocean Professional theme - dark */
    --bg-color: #0f172a;
    --background: #0f172a;
    --surface: #111827;
    --text-color: #f9fafb;
    --text-secondary: #d1d5db;
    --primary: #60A5FA;
    --secondary: #F59E0B;
    --error: #EF4444;
    --border-color: rgba(255, 255, 255, 0.15);
    --card-bg: rgba(31, 41, 55, 0.9);
    --card-hover-bg: rgba(31, 41, 55, 0.7);
    --shadow-color: rgba(0, 0, 0, 0.3);
    --shadow-hover-color: rgba(0, 0, 0, 0.4);
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background-color: var(--bg-color);
    color: var(--text-color);
    transition: background-color 0.3s ease, color 0.3s ease;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
  }

  * { box-sizing: border-box; }
  button { font-family: inherit; }
  input, textarea { font-family: inherit; }
</style>
