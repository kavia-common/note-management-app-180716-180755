---
import type { Note } from '../lib/store';
const props = Astro.props as {
  notes: Note[];
  selectedId: string | null;
};
---
<aside class="sidebar" data-collapsed="false">
  <header class="sidebar-header">
    <div class="brand">
      <div class="logo">✦</div>
      <div class="title">
        <span class="name">Ocean Notes</span>
        <span class="sub">Professional</span>
      </div>
    </div>
    <button id="sidebar-toggle" class="icon-btn" aria-label="Toggle sidebar">
      ☰
    </button>
  </header>

  <div class="actions">
    <button id="new-note" class="primary-btn">+ New</button>
  </div>

  <div class="search">
    <input id="search-input" type="search" placeholder="Search notes..." aria-label="Search notes" />
  </div>

  <nav id="notes-list" class="list" aria-label="Notes list">
    {props.notes.map((n) => (
      <button
        class={`item ${props.selectedId === n.id ? 'active' : ''}`}
        data-id={n.id}
        title={n.title}
      >
        <div class="item-title">{n.title || 'Untitled'}</div>
        <div class="item-meta">
          <span>{new Date(n.updatedAt).toLocaleString()}</span>
        </div>
      </button>
    ))}
  </nav>
</aside>

<style>
  .sidebar {
    width: 320px;
    min-width: 280px;
    max-width: 360px;
    background: var(--surface, #ffffff);
    border-right: 1px solid var(--border-color);
    height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform .3s ease, box-shadow .3s ease;
    box-shadow: 0 0 0 rgba(0,0,0,0);
    z-index: 10;
  }
  .sidebar[data-collapsed="true"] {
    transform: translateX(-100%);
    box-shadow: none;
  }
  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background: linear-gradient(120deg, rgba(37,99,235,0.08), rgba(249,250,251,0));
    border-bottom: 1px solid var(--border-color);
  }
  .brand {
    display: flex; gap: 10px; align-items: center;
  }
  .logo {
    width: 36px; height: 36px; border-radius: 10px;
    background: linear-gradient(135deg, #2563EB, #60A5FA);
    display: grid; place-items: center; color: white; font-weight: 800;
    box-shadow: 0 6px 18px rgba(37,99,235,0.25);
  }
  .title .name { font-weight: 700; color: var(--text-color); }
  .title .sub { font-size: 12px; color: var(--text-secondary); }
  .icon-btn {
    border: 1px solid var(--border-color);
    background: var(--surface);
    color: var(--text-color);
    border-radius: 10px;
    padding: 8px 10px;
    cursor: pointer;
    transition: all .2s ease;
  }
  .icon-btn:hover { box-shadow: 0 4px 10px rgba(0,0,0,.08); transform: translateY(-1px); }
  .actions { padding: 12px 16px; }
  .primary-btn {
    width: 100%;
    background: #2563EB;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 12px;
    font-weight: 600;
    cursor: pointer;
    transition: box-shadow .2s ease, transform .2s ease, background .2s ease;
    box-shadow: 0 8px 16px rgba(37,99,235,0.25);
  }
  .primary-btn:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
    box-shadow: 0 12px 22px rgba(37,99,235,0.35);
  }
  .search { padding: 0 16px 12px; }
  .search input {
    width: 100%;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: var(--surface);
    color: var(--text-color);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .search input:focus {
    outline: none;
    border-color: #2563EB;
    box-shadow: 0 0 0 4px rgba(37,99,235,0.15);
  }
  .list {
    overflow-y: auto;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .item {
    text-align: left;
    border: 1px solid var(--border-color);
    background: var(--surface);
    color: var(--text-color);
    border-radius: 12px;
    padding: 10px 12px;
    cursor: pointer;
    transition: border-color .2s, box-shadow .2s, transform .12s;
  }
  .item:hover { box-shadow: 0 6px 14px rgba(0,0,0,.06); transform: translateY(-1px); }
  .item.active {
    border-color: #2563EB;
    box-shadow: 0 6px 14px rgba(37,99,235,.15);
  }
  .item-title { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .item-meta { font-size: 12px; color: var(--text-secondary); margin-top: 4px; }
  @media (max-width: 768px) {
    .sidebar {
      position: fixed;
      left: 0; top: 0;
      height: 100dvh;
      box-shadow: 8px 0 24px rgba(0,0,0,.15);
      background: var(--surface);
    }
  }
</style>

<script>
  import { store } from '../lib/store';

  function mount() {
    const sidebar = document.querySelector('.sidebar');
    const toggleBtn = document.getElementById('sidebar-toggle');
    const newBtn = document.getElementById('new-note');
    const searchInput = document.getElementById('search-input');
    const list = document.getElementById('notes-list');

    function renderList(filter = '') {
      const notes = store.getNotes();
      const selected = store.getSelected();
      const f = filter.trim().toLowerCase();
      list.innerHTML = '';
      for (const n of notes) {
        if (f && !(`${n.title} ${n.content}`.toLowerCase().includes(f))) continue;
        const btn = document.createElement('button');
        btn.className = 'item' + (selected?.id === n.id ? ' active' : '');
        btn.dataset.id = n.id;
        btn.title = n.title || 'Untitled';
        btn.innerHTML = `
          <div class="item-title">${n.title || 'Untitled'}</div>
          <div class="item-meta"><span>${new Date(n.updatedAt).toLocaleString()}</span></div>
        `;
        btn.addEventListener('click', () => {
          store.select(n.id);
          // On small screens, collapse after selecting
          if (window.innerWidth < 768) {
            sidebar?.setAttribute('data-collapsed', 'true');
          }
        });
        list.appendChild(btn);
      }
    }

    toggleBtn?.addEventListener('click', () => {
      const collapsed = sidebar?.getAttribute('data-collapsed') === 'true';
      sidebar?.setAttribute('data-collapsed', collapsed ? 'false' : 'true');
    });

    newBtn?.addEventListener('click', () => {
      store.create();
      renderList(searchInput?.value || '');
    });

    searchInput?.addEventListener('input', () => {
      renderList(searchInput.value);
    });

    const unsub = store.subscribe(() => renderList(searchInput?.value || ''));
    renderList();

    // Ensure correct default state on mobile
    if (window.innerWidth < 768) sidebar?.setAttribute('data-collapsed', 'true');

    return () => unsub();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mount);
  } else {
    mount();
  }
</script>
